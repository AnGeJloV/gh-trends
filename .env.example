# Настройки пайплайна. Скопируй файл в .env (рядом с docker-compose.yml)
# и поправь под себя:  cp .env.example .env
# .env в git не коммитится — это твои локальные настройки.
# Без .env всё работает со значениями по умолчанию ниже.

# Период скачивания данных GH Archive
# Вариант А: N часов подряд от стартового часа (быстрый прогон, по умолчанию)
DOWNLOAD_FROM=2026-09-20
DOWNLOAD_HOURS=3
DOWNLOAD_START_HOUR=16

# Вариант Б: целый период по дням — задай DOWNLOAD_TO (он имеет приоритет
# над DOWNLOAD_HOURS). ВНИМАНИЕ: полный период проекта — это гигабайты
# и часы скачивания, но он НУЖЕН для обучения ML (история >= 3 недель).
# DOWNLOAD_FROM=2026-09-01
# DOWNLOAD_TO=2026-09-30
